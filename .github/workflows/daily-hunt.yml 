name: Kavian Prime Daily Hunt

on:
  schedule:
    - cron: '30 4 * * *'
    - cron: '30 16 * * *'
  workflow_dispatch:

jobs:
  run-bot:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-python@v4
        with:
          python-version: '3.10'
      - run: pip install requests
      - run: python bot.py
      - run: |
          git config --global user.name "KavianBot"
          git config --global user.email "bot@kavian.com"
          git add kavian_memory.json
          git commit -m "Save memory" || echo "No changes"
          git push
